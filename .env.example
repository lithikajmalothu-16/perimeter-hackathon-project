# Copy to .env in the repo root (one variable per line)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
DATABASE_PATH=backend/data/pathfinder.db
# Router refetch threshold in hours. Set to 1 before the demo so step 2 shows a live refetch.
STALE_HOURS=168
# 1 = background refresh (calendars every 3h, pages every 24h). "Run now" on the Sources page always works.
SCHEDULER_ENABLED=0
CORS_ORIGINS=http://localhost:5173
HTTP_USER_AGENT=PathfinderGSU/1.0 (HackPerimeter student project; contact: your-email@student.gsu.edu)
# 1 = serve data/demo_cache.json for the two demo chat queries if both LLMs fail
DEMO_FALLBACK=1
VITE_API_BASE_URL=http://localhost:8000/api
